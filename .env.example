# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://podmonitor:podmonitor@localhost:5432/podmonitor

# Separate database used by `npm test`; created by the test bootstrap if missing.
TEST_DATABASE_URL=postgres://podmonitor:podmonitor@localhost:5432/podmonitor_test

# bcrypt work factor for password hashing (10-12 in real environments, 4 in tests)
BCRYPT_COST=12

# Session lifetime in days
SESSION_TTL_DAYS=30

# Transcription sidecar (sidecar/README.md). Unset disables ASR: episodes without an
# in-feed transcript then fail the acquisition stage rather than silently stalling.
WHISPER_SIDECAR_URL=http://localhost:8081

# Ceiling for one transcription request. A 3h default is deliberate: on CPU a long
# episode legitimately takes tens of minutes, and a tight timeout retries forever.
WHISPER_SIDECAR_TIMEOUT_MS=10800000

# Refuse to download an episode larger than this (500 MB).
MAX_EPISODE_AUDIO_BYTES=524288000

# Which LLM adapter the summarization job uses: groq (default, free tier), openai, or
# anthropic. Switching providers is this one variable, never a code change.
LLM_PROVIDER=groq

# Overrides the active provider's default model. Unset uses the adapter's own default.
# LLM_MODEL=

# Ceiling for one summarization request.
LLM_REQUEST_TIMEOUT_MS=60000

# Attempts for one summarization call before giving up and letting pg-boss's own retry
# take over. Free-tier rate limits are the expected failure mode.
LLM_MAX_ATTEMPTS=4
LLM_RETRY_BASE_DELAY_MS=2000

# Exactly one of these is required, matching LLM_PROVIDER above.
GROQ_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Which embedding adapter builds insight vectors: local (default) or openai.
#   local  — deterministic feature hashing, computed in-process. Free, offline,
#            lexical rather than semantic. Good enough to catch restatements.
#   openai — text-embedding-3-small at 1536 dimensions (~$0.02 per 1M tokens);
#            needs OPENAI_API_KEY. Real semantics, tiny cost.
# Switching after insights exist means re-embedding them: vectors from different
# providers are not comparable.
EMBEDDING_PROVIDER=local

# Overrides the active adapter's default model (openai only).
# EMBEDDING_MODEL=

# Ceiling for one embedding request.
EMBEDDING_REQUEST_TIMEOUT_MS=30000

# Cross-referencing thresholds. Cosine similarity at or above this links two
# insights; 0.55 keeps restatements and drops coincidental topical overlap.
INSIGHT_LINK_THRESHOLD=0.55

# Most links kept per new insight, strongest first — a callout list, not a dump.
INSIGHT_LINK_MAX_PER_INSIGHT=3

# How many pgvector neighbours are fetched before thresholding.
INSIGHT_LINK_CANDIDATE_POOL=20

# Which email adapter the digest job uses: resend (default, free tier) or smtp. Switching
# providers is this one variable, never a code change.
EMAIL_PROVIDER=resend

# The verified sender address the weekly digest is sent from.
EMAIL_FROM=digest@example.com

# Ceiling for one Resend send request.
EMAIL_REQUEST_TIMEOUT_MS=30000

# Required when EMAIL_PROVIDER=resend.
RESEND_API_KEY=

# Required when EMAIL_PROVIDER=smtp.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# Base URL the digest email links back to.
APP_BASE_URL=http://localhost:3000

# Render every digest without sending or persisting a digests row. Off by default; a
# staging deploy can flip this to preview real content without risking a real send.
DIGEST_DRY_RUN=false
